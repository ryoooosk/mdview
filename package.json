{
  "name": "mdview",
  "version": "0.1.0",
  "private": true,
  "description": "Render Markdown in the terminal with mermaid diagrams shown as images (kitty graphics protocol)",
  "type": "module",
  "bin": {
    "mdv": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "styles/code.json"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "check": "biome check --write --no-errors-on-unmatched",
    "biome:ci": "biome ci",
    "test": "node --test 'src/**/*.test.ts'",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include-all --test-coverage-include='src/**/*.ts' --test-coverage-exclude='src/**/*.test.ts' 'src/**/*.test.ts'"
  },
  "author": "ryoooosk",
  "license": "SEE LICENSE IN README.md",
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": [
      {
        "name": "npm"
      },
      {
        "name": "pnpm",
        "version": "12.3.4",
        "onFail": "download"
      }
    ]
  },
  "packageManager": "pnpm@12.3.4",
  "dependencies": {
    "@mermaid-js/mermaid-cli": "12.0.0",
    "mdast-util-from-markdown": "^2.0.3",
    "puppeteer": "^25.12.0",
    "unist-util-visit": "^5.1.0"
  },
  "puppeteer": {
    "skipDownload": true
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^24.19.0",
    "typescript": "^7.0.2"
  }
}
